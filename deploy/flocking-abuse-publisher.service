[Unit]
Description=Flocking Abuse protected report publisher
After=local-fs.target
Before=flocking-abuse.service

[Service]
Type=simple
User=root
Group=flocking-abuse
WorkingDirectory=/opt/flocking-abuse/current
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/flocking-abuse/data
Environment=DOCS_DIR=/opt/flocking-abuse/current/docs
Environment=PUBLISHER_SOCKET=/run/flocking-abuse/publisher.sock
EnvironmentFile=/etc/flocking-abuse/release.env
ExecStart=/usr/bin/node --preserve-symlinks-main /opt/flocking-abuse/current/dist-server/server/publisher.js
Restart=on-failure
RestartSec=5
RuntimeDirectory=flocking-abuse
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadOnlyPaths=/opt/flocking-abuse/current
ReadWritePaths=/var/lib/flocking-abuse/data /run/flocking-abuse
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
